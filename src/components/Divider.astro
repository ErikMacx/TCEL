---
// Section divider: a fine rule broken by a hatched block (the portrait's
// hatching) holding a bronze diamond. Decorative, so hidden from screen readers.
---

<div class="divider wrap" aria-hidden="true"><span class="mark"><i></i></span></div>

<style>
  .divider{display:flex;align-items:center;gap:.5rem}
  .divider::before,.divider::after{content:"";flex:1;height:1px;background:var(--line)}
  .mark{position:relative;width:38px;height:24px;border:1px solid var(--line);background:repeating-linear-gradient(135deg,transparent 0 6px,rgba(166,113,43,.3) 6px 7px);flex:none}
  .mark i{position:absolute;left:50%;top:50%;width:9px;height:9px;background:var(--accent);transform:translate(-50%,-50%) rotate(45deg)}
</style>
